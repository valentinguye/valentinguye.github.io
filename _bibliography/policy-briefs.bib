@misc{trase2024seipcs,
  title     = {SEI-PCS C{\^o}te d'Ivoire cocoa v1.1 supply chain map: Data sources and methods},
  author    = {{Trase}},
  year      = {2024},
  publisher = {Trase},
  doi       = {10.48650/3KGC-VB46},
  html      = {https://doi.org/10.48650/3KGC-VB46},
  abstract  = {Trase maps supply chains for agricultural commodities, making it possible to link products and supply chain actors with specific areas of production, and associated sustainability risks and opportunities. It uses a generalised supply chain mapping approach called Spatially Explicit Information on Production to Consumption Systems (SEI-PCS) as the basis for this work (Godar et al., 2015). This document describes the data and methods that Trase has used to map the cocoa supply chain in Côte d'Ivoire, called ‘SEI-PCS Côte d'Ivoire cocoa’, based on Renier et al (2023). Trase’s supply chain mapping of Côte d’Ivoire cocoa results from a collaboration between experts at the Stockholm Environment Institute and Université Catholique de Louvain (UCLouvain). The supply chain map allocates cocoa exports to farmer cooperatives and departments of production in Côte d'Ivoire by integrating supply chain disclosure data and trade data according to the supply chain schematic in Figure 1. Table 1 provides an overview of key statistics for Côte d’Ivoire’s cocoa industry during 2019–2024. Trase further integrates its supply chain model with a variety of sustainability metrics to detail the regional impacts of commodity trade.},
   category  = {policy-brief}
}

@misc{richens2023trase_ghana,
  title     = {Cocoa traders fall short on supplier disclosure in Ghana},
  author    = {Richens, J.A.E. and Guye, V. and {zu Ermgassen}, E.},
  year      = {2023},
  publisher = {Trase},
  doi       = {10.48650/HY9G-N485},
  html      = {https://trase.earth/insights/cocoa-traders-fall-short-on-supplier-disclosure-in-ghana},
  abstract  = {Companies exporting cocoa from Ghana are failing to publicly demonstrate that their supplies are not grown on deforested land, according to research by Trase, raising questions over their sustainability commitments and their preparedness to comply with the EU deforestation regulation.},
 category  = {policy-brief}
}
